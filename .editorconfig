# Editor defaults matching the style rules in CONTRIBUTING.md.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{py,c,h}]
indent_size = 4
max_line_length = 110

[*.{ps1,bat,cmd}]
indent_size = 4
end_of_line = crlf

[*.sh]
indent_size = 4
end_of_line = lf

[*.{md,yml,yaml,json,toml}]
indent_size = 2
